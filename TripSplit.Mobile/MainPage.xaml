<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TripSplit.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Мої подорожі">

    <Grid
        Padding="24"
        RowDefinitions="Auto,*">

        <Button
            Text="+ Нова подорож"
            HorizontalOptions="End"
            Margin="0,0,0,20"
            Command="{Binding AddTripCommand}" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Trips}"
            SelectedItem="{Binding SelectedTrip, Mode=TwoWay}"
            SelectionMode="Single">

            <CollectionView.EmptyView>

                <Label
                    Text="Подорожей поки немає"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="16"
                        Margin="0,0,0,12"
                        StrokeThickness="1">

                        <VerticalStackLayout
                            Spacing="6">

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Destination}"
                                FontSize="16" />

                            <HorizontalStackLayout
                                Spacing="5">

                                <Label
                                    Text="{Binding StartDate,
                                        StringFormat='{0:dd.MM.yyyy}'}" />

                                <Label Text="—" />

                                <Label
                                    Text="{Binding EndDate,
                                        StringFormat='{0:dd.MM.yyyy}'}" />

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>