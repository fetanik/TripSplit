<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TripSplit.Views.BalancesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>

        <VerticalStackLayout
            Padding="36,20,24,24"
            Spacing="20">

            <Label
                Text="Баланси та розрахунки"
                FontSize="32"
                FontAttributes="Bold"
                Margin="0,0,0,10" />

            <Border
                Padding="18"
                StrokeThickness="1">

                <Grid
                    ColumnDefinitions="*,Auto">

                    <Label
                        Text="Загальні витрати"
                        FontSize="18"
                        VerticalOptions="Center" />

                    <Label
                        x:Name="TotalExpensesLabel"
                        Grid.Column="1"
                        FontSize="20"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <Label
                Text="Баланси учасників"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <VerticalStackLayout
                x:Name="BalancesLayout"
                Spacing="10">

                <BindableLayout.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="16"
                            StrokeThickness="1">

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                RowSpacing="6">

                                <Label
                                    Text="{Binding ParticipantName}"
                                    FontSize="20"
                                    FontAttributes="Bold" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding BalanceText}"
                                    FontSize="19"
                                    FontAttributes="Bold" />

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding PaidText}"
                                    FontSize="15" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding BalanceDescription}"
                                    FontSize="15"
                                    Opacity="0.7" />

                                <Label
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding OwedText}"
                                    FontSize="15"
                                    Opacity="0.7" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            <Label
                Text="Рекомендовані перекази"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,15,0,0" />

            <Label
                x:Name="NoSettlementsLabel"
                Text="Додаткових переказів не потрібно"
                FontSize="16"
                Opacity="0.6"
                IsVisible="False" />

            <VerticalStackLayout
                x:Name="SettlementsLayout"
                Spacing="10">

                <BindableLayout.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="16"
                            StrokeThickness="1">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <Label
                                    Text="{Binding TransferText}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding AmountText}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>