<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TripSplit.Views.AddTripPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>

        <VerticalStackLayout
            Padding="36,20,24,24"
            Spacing="18">

            <Label
                Text="Нова подорож"
                FontSize="32"
                FontAttributes="Bold"
                Margin="0,0,0,10" />

            <Label
                Text="Назва подорожі"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding Name, Mode=TwoWay}"
                Placeholder="Наприклад, Карпати 2027" />

            <Label
                Text="Місце призначення"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding Destination, Mode=TwoWay}"
                Placeholder="Наприклад, Яремче" />

            <Label
                Text="Дата початку"
                FontAttributes="Bold" />

            <DatePicker
                Date="{Binding StartDate, Mode=TwoWay}" />

            <Label
                Text="Дата завершення"
                FontAttributes="Bold" />

            <DatePicker
                Date="{Binding EndDate, Mode=TwoWay}" />

            <Button
                Text="Створити подорож"
                Command="{Binding SaveCommand}"
                HeightRequest="55"
                Margin="0,10,0,0" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>