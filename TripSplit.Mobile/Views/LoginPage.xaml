<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TripSplit.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="40"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="TripSplit"
                FontSize="42"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,40,0,0" />

            <Label
                Text="Увійдіть до свого акаунта"
                FontSize="18"
                Opacity="0.7"
                HorizontalOptions="Center"
                Margin="0,0,0,25" />

            <Label
                Text="Електронна адреса"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding Email, Mode=TwoWay}"
                Placeholder="name@example.com"
                Keyboard="Email" />

            <Label
                Text="Пароль"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding Password, Mode=TwoWay}"
                Placeholder="Введіть пароль"
                IsPassword="True" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Button
                Text="Увійти"
                Command="{Binding LoginCommand}"
                HeightRequest="55"
                Margin="0,10,0,0" />

            <Label
                Text="Ще не маєте акаунта?"
                HorizontalOptions="Center"
                Margin="0,15,0,0" />

            <Button
                Text="Зареєструватися"
                Command="{Binding OpenRegisterCommand}"
                BackgroundColor="Transparent" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>