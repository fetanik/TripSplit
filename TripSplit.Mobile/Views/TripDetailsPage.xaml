<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TripSplit.Views.TripDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>

        <VerticalStackLayout
            Padding="36,20,24,24"
            Spacing="20">

            <Label
                Text="Деталі подорожі"
                FontSize="32"
                FontAttributes="Bold"
                Margin="0,0,0,25" />

            <Label
                Text="{Binding Name}"
                FontSize="32"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Destination}"
                FontSize="20" />

            <Label
                Text="{Binding DateRange}"
                FontSize="16"
                Margin="0,5,0,10" />

            <BoxView
                HeightRequest="1"
                Margin="0,10,0,15"
                Opacity="0.2" />

            <Button
                Text="Учасники"
                HeightRequest="55"
                Command="{Binding OpenParticipantsCommand}" />

            <Button
                Text="Витрати"
                HeightRequest="55"
                Command="{Binding OpenExpensesCommand}" />

            <Button
                Text="Баланси та розрахунки"
                HeightRequest="55"
                Command="{Binding OpenBalancesCommand}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>