<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TripSplit.Views.TripDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>

        <VerticalStackLayout
            Padding="36,20,24,24"
            Spacing="20">

            <Label
                Text="Деталі подорожі"
                FontSize="32"
                FontAttributes="Bold"
                Margin="0,0,0,25" />

            <Label
                x:Name="NameLabel"
                FontSize="32"
                FontAttributes="Bold" />

            <Label
                x:Name="DestinationLabel"
                FontSize="20" />

            <HorizontalStackLayout
                Spacing="6"
                Margin="0,5,0,10">

                <Label
                    x:Name="StartDateLabel"
                    FontSize="16" />

                <Label
                    Text="—"
                    FontSize="16" />

                <Label
                    x:Name="EndDateLabel"
                    FontSize="16" />

            </HorizontalStackLayout>

            <BoxView
                HeightRequest="1"
                Margin="0,10,0,15"
                Opacity="0.2" />

            <Button
                Text="Учасники"
                HeightRequest="55"
                Clicked="OnParticipantsClicked" />

            <Button
                Text="Витрати"
                HeightRequest="55" />

            <Button
                Text="Баланси та розрахунки"
                HeightRequest="55" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>