<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TripSplit.Views.ExpensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        Padding="36,20,24,24"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="20">

        <Label
            Text="Витрати"
            FontSize="32"
            FontAttributes="Bold" />

        <Button
            Grid.Row="1"
            Text="+ Нова витрата"
            HorizontalOptions="End"
            Clicked="OnAddExpenseClicked" />

        <CollectionView
            x:Name="ExpensesCollectionView"
            Grid.Row="2">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8">

                    <Label
                        Text="Витрат поки немає"
                        FontSize="18"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Додайте першу витрату подорожі"
                        Opacity="0.6"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="16"
                        Margin="0,0,0,12"
                        StrokeThickness="1">

                        <Grid
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            ColumnDefinitions="*,Auto"
                            RowSpacing="6">

                            <Label
                                Text="{Binding Title}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding AmountText}"
                                FontSize="18"
                                FontAttributes="Bold" />

                            <Label
                                Grid.Row="1"
                                Text="{Binding PaidByText}"
                                FontSize="15" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding DateText}"
                                FontSize="15"
                                Opacity="0.7" />

                            <Label
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Text="{Binding Note}"
                                FontSize="14"
                                Opacity="0.7" />

                            <HorizontalStackLayout
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                HorizontalOptions="End"
                                Spacing="10"
                                Margin="0,8,0,0">

                                <Button
                                    Text="Редагувати"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnEditExpenseClicked" />

                                <Button
                                    Text="Видалити"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnDeleteExpenseClicked" />

                            </HorizontalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>