<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TripSplit.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="18">

        <Label
            Text="TripSplit"
            FontSize="40"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <ActivityIndicator
            IsRunning="True"
            WidthRequest="40"
            HeightRequest="40" />

        <Label
            Text="Завантаження..."
            Opacity="0.6"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>